{
  "format_version": "1.21.10",
  "minecraft:block": {
    "description": {
      "identifier": "fnaf:breaker_box_1",
      "menu_category": {
        "category": "items",
        "group": "itemGroup.name.miscellaneous"
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"]
        }
      }
    },
    "components": {
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 1.2 },
      "minecraft:destructible_by_explosion": { "explosion_resistance": 10 },
      "minecraft:map_color": "#2a2a2a",
      "minecraft:geometry": "geometry.fnaf.breaker_panel",
      "minecraft:material_instances": {
        "*":     { "texture": "fnaf_breaker_panel_side",  "render_method": "opaque" },
        "north": { "texture": "fnaf_breaker_panel_front", "render_method": "opaque" },
        "up":    { "texture": "fnaf_breaker_panel_side",  "render_method": "opaque" },
        "down":  { "texture": "fnaf_breaker_panel_side",  "render_method": "opaque" },
        "east":  { "texture": "fnaf_breaker_panel_side",  "render_method": "opaque" },
        "west":  { "texture": "fnaf_breaker_panel_side",  "render_method": "opaque" },
        "south": { "texture": "fnaf_breaker_panel_side",  "render_method": "opaque" }
      },
      "minecraft:collision_box": {
        "origin": [-6, 3, -8],
        "size":   [12, 12, 2]
      },
      "minecraft:selection_box": {
        "origin": [-6, 3, -8],
        "size":   [12, 12, 2]
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 180, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 90, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 270, 0] }
        }
      }
    ]
  }
}
