{
  "namespace": "server_form",

  "tile_button_image": {
    "type": "image",
    "size": [16, 16],
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#form_button_texture",
        "binding_name_override": "#texture",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  },

  "tile_button": {
    "type": "button",
    "size": [16, 16],
    "$pressed_button_name": "button.form_button_click",
    "layer": 1,
    "controls": [
      { "img@server_form.tile_button_image": {} }
    ],
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ]
  },

  "tile_grid": {
    "type": "grid",
    "size": [256, 160],
    "grid_dimensions": [16, 10],
    "grid_item_template": "server_form.tile_button",
    "collection_name": "form_buttons",
    "anchor_from": "center",
    "anchor_to": "center",
    "offset": [0, 12],
    "bindings": [
      {
        "binding_name": "#form_button_length",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "tile_title": {
    "type": "label",
    "text": "#title_text",
    "color": [0.94, 0.95, 0.92],
    "font_scale_factor": 1.2,
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [0, 10],
    "bindings": [
      { "binding_name": "#title_text" }
    ]
  },

  "close_x": {
    "type": "button",
    "size": [16, 16],
    "$pressed_button_name": "button.menu_exit",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [-4, 4],
    "controls": [
      {
        "x_label": {
          "type": "label",
          "text": "X",
          "color": [0.85, 0.85, 0.85],
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },

  "backdrop": {
    "type": "image",
    "texture": "textures/ui/Black",
    "size": [300, 220],
    "alpha": 0.95,
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 0
  },

  "long_form": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      { "bg@server_form.backdrop": {} },
      { "title@server_form.tile_title": {} },
      { "grid@server_form.tile_grid": {} },
      { "close@server_form.close_x": {} }
    ]
  }
}
