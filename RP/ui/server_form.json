{
  "namespace": "server_form",

  //
  // Every custom title in this addon starts with FNAF|. The vanilla
  // fallback wrapper is hidden whenever the title contains FNAF|; each
  // per-form wrapper further gates on its inner sub-prefix. Skyls'
  // common_dialogs.main_panel_no_buttons still provides the chrome.
  //

  "long_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "default_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 225, 200 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - 'FNAF|') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "electrical_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 340, 280 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.electrical_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'FNAF|ELECTRICAL_MAP|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "anim_editor_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 140, 140 ],
          "anchor_from": "center",
          "anchor_to":   "center",
          "offset": [ 140, 0 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.anim_editor_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'FNAF|ANIM_EDITOR|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "proof_u4_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 340, 280 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.proof_u4_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'FNAF|PROOF_U4|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "proof_u8_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 340, 280 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.proof_u8_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'FNAF|PROOF_U8|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  // ================================================================
  //   ANIMATRONIC EDITOR (compact floating-style panel)
  //
  //   ActionForm supplies 9 buttons in fixed order:
  //     0: rotation -    1: rotation value    2: rotation +
  //     3: anim prev     4: anim value        5: anim next
  //     6: misc-1        7: misc-2            8: misc-3
  //
  //   Layout: title chrome (from Skyls' main_panel_no_buttons) + three
  //   labeled sections stacked vertically. Each section is a 3-cell grid
  //   that iterates the SAME form_buttons collection but is scoped to
  //   its slice via a per-cell $collection_index override.
  // ================================================================

  //
  // Verified pattern from electrical_canvas: one `type: grid` iterating the
  // whole form_buttons collection in order. Custom per-cell index overrides
  // (property_bag, view-bound $slot_index) all failed in U1/U2/U3 — do not
  // reintroduce them. Section labels sit above the grid because
  // interleaving them between grid rows requires exactly that failed
  // pattern; buttons self-label instead (e.g. "◄" / "Idle" / "►").
  //
  "anim_editor_canvas": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100% - 8px", "100% - 22px" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 4 ],
    "controls": [
      {
        "section_hint": {
          "type": "label",
          "size": [ "100%", 10 ],
          "text": "§7Rotation §8· §7Animation §8· §7Misc",
          "text_alignment": "center",
          "color": [ 0.8, 0.8, 0.85 ],
          "shadow": true
        }
      },
      { "spacer_top": { "type": "panel", "size": [ "100%", 4 ] } },
      {
        "grid_wrap": {
          "type": "grid",
          "size": [ 120, 90 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "grid_dimensions": [ 3, 3 ],
          "grid_item_template": "server_form.anim_editor_cell",
          "collection_name": "form_buttons"
        }
      }
    ]
  },

  //
  // Reuse the same cell chrome pattern the U8 proof verified: an image bg
  // via textures/ui/White (with collection_details for click routing) plus
  // a text-bearing button using #form_button_text -> #label. That override
  // is the one Bedrock actually populates for ActionForm buttons — plain
  // label + #text binding did not. Text lives on the button itself, not a
  // sibling label.
  //
  //
  // Cell chrome (3 image layers + button):
  //   1. Outer border tint (light)
  //   2. Inner dark fill (creates 1px bordered slot look)
  //   3. Highlight strip along the top for subtle depth
  //   Then the interactive text button on top.
  //
  "anim_editor_cell": {
    "type": "panel",
    "size": [ 40, 30 ],
    "controls": [
      {
        "cell_border": {
          "type": "image",
          "size": [ "100% - 2px", "100% - 2px" ],
          "layer": 1,
          "texture": "textures/ui/White",
          "color": [ 0.55, 0.55, 0.60 ],
          "alpha": 0.9
        }
      },
      {
        "cell_fill": {
          "type": "image",
          "size": [ "100% - 4px", "100% - 4px" ],
          "layer": 2,
          "texture": "textures/ui/White",
          "color": [ 0.14, 0.14, 0.16 ],
          "alpha": 0.95
        }
      },
      {
        "cell_top_hi": {
          "type": "image",
          "size": [ "100% - 6px", 1 ],
          "layer": 3,
          "anchor_from": "top_middle",
          "anchor_to":   "top_middle",
          "offset": [ 0, 2 ],
          "texture": "textures/ui/White",
          "color": [ 0.75, 0.75, 0.80 ],
          "alpha": 0.5
        }
      },
      {
        "cell_text": {
          "type": "label",
          "size": [ "100% - 6px", "100% - 6px" ],
          "layer": 4,
          "anchor_from": "center",
          "anchor_to":   "center",
          "text_alignment": "center",
          "color": [ 1, 1, 1 ],
          "shadow": true,
          "font_scale_factor": 1.0,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_name_override": "#text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "cell_hitbox": {
          "type": "button",
          "size": [ "100%", "100%" ],
          "layer": 5,
          "$pressed_button_name": "button.form_button_click",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // ================================================================
  //   ELECTRICAL PANEL (production form)
  // ================================================================

  "electrical_canvas": {
    "type": "grid",
    "size": [ 288, 216 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "grid_dimensions": [ 24, 18 ],
    "grid_item_template": "server_form.electrical_cell",
    "collection_name": "form_buttons"
  },

  "electrical_cell": {
    "type": "panel",
    "size": [ 12, 12 ],
    "controls": [
      {
        "cell_image": {
          "type": "image",
          "size": [ "100%", "100%" ],
          "layer": 1,
          "bindings": [
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture_file_system",
              "binding_name_override": "#texture_file_system",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "cell_hitbox": {
          "type": "button",
          "size": [ "100%", "100%" ],
          "layer": 2,
          "$pressed_button_name": "button.form_button_click",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // ================================================================
  //   PROOF EXPERIMENTS (docs/phase-0-inventory.md)
  // ================================================================

  //
  // U1 is settled — dead. All three variants (view binding to
  // custom #slot_x, property_bag, view binding to #offset_x) either
  // failed cleanly (v1) or crashed the file (v2/v3). Recorded as a
  // rejected pattern; migration commits to Path B (fixed pool).
  //

  //
  // U4 — direct texture path, no bindings.
  //
  "proof_u4_canvas": {
    "type": "panel",
    "size": [ 100, 100 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "swatch": {
          "type": "image",
          "size": [ 32, 32 ],
          "texture": "textures/ui/White",
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },

  //
  // U8 — every slot renders bar + hitbox; hitbox visibility depends on
  // whether the button's text is "keep" (kept) vs "hide" (hidden hitbox
  // but bar still rendered).
  //
  "proof_u8_canvas": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 200, "100%" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 20 ],
    "controls": [
      { "slot@server_form.proof_u8_slot": {} }
    ],
    "collection_name": "form_buttons"
  },
  "proof_u8_slot": {
    "type": "panel",
    "size": [ "100%", 16 ],
    "controls": [
      {
        "always_bar": {
          "type": "image",
          "size": [ "100%", 4 ],
          "layer": 1,
          "anchor_from": "center",
          "anchor_to": "center",
          "texture": "textures/ui/White",
          "bindings": [
            { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }
          ]
        }
      },
      {
        "conditional_hitbox": {
          "type": "button",
          "size": [ "100%", "100%" ],
          "layer": 2,
          "$pressed_button_name": "button.form_button_click",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_name_override": "#label",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#label = 'keep')",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
