{
  "namespace": "server_form",

  //
  // Every custom title in this addon starts with FNAF|. The vanilla
  // fallback wrapper is hidden whenever the title contains FNAF|; each
  // per-form wrapper further gates on its inner sub-prefix. Skyls'
  // common_dialogs.main_panel_no_buttons still provides the chrome.
  //

  "long_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "default_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 225, 200 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - 'FNAF|') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "electrical_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 340, 280 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.electrical_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'FNAF|ELECTRICAL_MAP|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "proof_u1a_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 340, 280 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.proof_u1a_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'FNAF|PROOF_U1A|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "proof_u1b_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 340, 280 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.proof_u1b_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'FNAF|PROOF_U1B|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "proof_u1c_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 340, 280 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.proof_u1c_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'FNAF|PROOF_U1C|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "proof_u4_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 340, 280 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.proof_u4_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'FNAF|PROOF_U4|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "proof_u8_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 340, 280 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.proof_u8_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'FNAF|PROOF_U8|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  // ================================================================
  //   ELECTRICAL PANEL (production form)
  // ================================================================

  "electrical_canvas": {
    "type": "grid",
    "size": [ 288, 216 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "grid_dimensions": [ 24, 18 ],
    "grid_item_template": "server_form.electrical_cell",
    "collection_name": "form_buttons"
  },

  "electrical_cell": {
    "type": "panel",
    "size": [ 12, 12 ],
    "controls": [
      {
        "cell_image": {
          "type": "image",
          "size": [ "100%", "100%" ],
          "layer": 1,
          "bindings": [
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture_file_system",
              "binding_name_override": "#texture_file_system",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "cell_hitbox": {
          "type": "button",
          "size": [ "100%", "100%" ],
          "layer": 2,
          "$pressed_button_name": "button.form_button_click",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // ================================================================
  //   PROOF EXPERIMENTS (docs/phase-0-inventory.md)
  // ================================================================

  //
  // U1a — view-binding writes a computed #slot_x, offset reads it.
  // Canvas is a stack_panel because `panel` doesn't accept
  // collection_name (that was the JSON crash the last round).
  //
  "proof_u1a_canvas": {
    "type": "stack_panel",
    "size": [ 200, 100 ],
    "orientation": "vertical",
    "anchor_from": "center",
    "anchor_to": "center",
    "collection_name": "form_buttons",
    "controls": [
      { "slot@server_form.proof_u1a_slot": {} }
    ]
  },
  "proof_u1a_slot": {
    "type": "image",
    "size": [ 20, 4 ],
    "texture": "textures/ui/White",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ "#slot_x", 0 ],
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
      {
        "binding_type": "view",
        "source_property_name": "(#collection_index * 30)",
        "target_property_name": "#slot_x"
      }
    ]
  },

  //
  // U1b — property_bag maps #slot_x to a computed expression.
  //
  "proof_u1b_canvas": {
    "type": "stack_panel",
    "size": [ 200, 100 ],
    "orientation": "vertical",
    "anchor_from": "center",
    "anchor_to": "center",
    "collection_name": "form_buttons",
    "controls": [
      { "slot@server_form.proof_u1b_slot": {} }
    ]
  },
  "proof_u1b_slot": {
    "type": "image",
    "size": [ 20, 4 ],
    "texture": "textures/ui/White",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "property_bag": {
      "#slot_x": "(#collection_index * 30)"
    },
    "offset": [ "#slot_x", 0 ],
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }
    ]
  },

  //
  // U1c — same view-binding technique as U1a but targeting the
  // magic `#offset_x` property directly (if Bedrock recognises that
  // as a first-class offset override). Different target from U1a's
  // custom `#slot_x`.
  //
  "proof_u1c_canvas": {
    "type": "stack_panel",
    "size": [ 200, 100 ],
    "orientation": "vertical",
    "anchor_from": "center",
    "anchor_to": "center",
    "collection_name": "form_buttons",
    "controls": [
      { "slot@server_form.proof_u1c_slot": {} }
    ]
  },
  "proof_u1c_slot": {
    "type": "image",
    "size": [ 20, 4 ],
    "texture": "textures/ui/White",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
      {
        "binding_type": "view",
        "source_property_name": "(#collection_index * 30)",
        "target_property_name": "#offset_x"
      }
    ]
  },

  //
  // U4 — direct texture path, no bindings.
  //
  "proof_u4_canvas": {
    "type": "panel",
    "size": [ 100, 100 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "swatch": {
          "type": "image",
          "size": [ 32, 32 ],
          "texture": "textures/ui/White",
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },

  //
  // U8 — every slot renders bar + hitbox; hitbox visibility depends on
  // whether the button's text is "keep" (kept) vs "hide" (hidden hitbox
  // but bar still rendered).
  //
  "proof_u8_canvas": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 200, "100%" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 20 ],
    "controls": [
      { "slot@server_form.proof_u8_slot": {} }
    ],
    "collection_name": "form_buttons"
  },
  "proof_u8_slot": {
    "type": "panel",
    "size": [ "100%", 16 ],
    "controls": [
      {
        "always_bar": {
          "type": "image",
          "size": [ "100%", 4 ],
          "layer": 1,
          "anchor_from": "center",
          "anchor_to": "center",
          "texture": "textures/ui/White",
          "bindings": [
            { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }
          ]
        }
      },
      {
        "conditional_hitbox": {
          "type": "button",
          "size": [ "100%", "100%" ],
          "layer": 2,
          "$pressed_button_name": "button.form_button_click",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_name_override": "#label",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#label = 'keep')",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
