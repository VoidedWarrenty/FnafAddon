{
  "namespace": "server_form",

  //
  // Adapted from Skyls' working sample
  // (skyls.de/samples/ui4/RP/ui/server_form.json).
  //
  // The pattern: override `long_form` (the whole ActionForm root, NOT
  // the inner buttons panel) with a `panel` containing two siblings.
  // Both inherit from `common_dialogs.main_panel_no_buttons` — that
  // gives us the native chrome (grey border, title bar, close X)
  // without the vanilla button stack, and it exposes a `$child_control`
  // variable that we swap between vanilla and our custom canvas.
  //
  // Visibility on each sibling is a straight title-string check via
  // MoLang subtraction. The bindings live on the WRAPPER, not inside
  // the collection-iterating buttons_panel, so scope isn't a problem
  // this time.
  //
  // Non-electrical forms → default_long_form visible → $child_control =
  // vanilla `server_form.long_form_panel` → vanilla button stack. Zero
  // interference with blueprint editor or unconfigured breaker panel.
  //

  "long_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "default_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 225, 200 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - 'ELECTRICAL_MAP|') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "electrical_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 340, 280 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.electrical_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'ELECTRICAL_MAP|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "proof_u1_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 340, 280 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.proof_u1_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'PROOF_U1|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "proof_u4_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 340, 280 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.proof_u4_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'PROOF_U4|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "proof_u8_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [ "100% - 14px", 10 ],
          "size": [ 340, 280 ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.proof_u8_canvas",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'PROOF_U8|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  // -- Custom canvas: 32x24 grid of tile cells, one per form button --

  "electrical_canvas": {
    "type": "grid",
    "size": [ 288, 216 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "grid_dimensions": [ 24, 18 ],
    "grid_item_template": "server_form.electrical_cell",
    "collection_name": "form_buttons"
  },

  // -- One cell: 10x10 panel with a tile image + click hitbox --
  // The image reads the button's texture path (`#form_button_texture`)
  // via a collection binding renamed to `#texture`. The hitbox is a
  // `common_buttons.light_text_button` — the ACTUAL base that resolves
  // in current Bedrock (not light_content_button, which doesn't).
  // `binding_type: collection_details` on the hitbox is what wires the
  // click back to the form's button-click event with the right index.

  "electrical_cell": {
    "type": "panel",
    "size": [ 12, 12 ],
    "controls": [
      {
        "cell_image": {
          "type": "image",
          "size": [ "100%", "100%" ],
          "layer": 1,
          "bindings": [
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture_file_system",
              "binding_name_override": "#texture_file_system",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "cell_hitbox": {
          "type": "button",
          "size": [ "100%", "100%" ],
          "layer": 2,
          "$pressed_button_name": "button.form_button_click",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  //
  // =========================================================
  //   PROOF-OF-CONCEPT experiments  (see docs/phase-0-inventory.md)
  //   Each canvas + slot is independent; failures on one don't
  //   affect the others or the electrical form.
  // =========================================================
  //

  // -- U1 · offset binding to derived value ---------------------------
  // The proof: five slots, each with `offset[0]` computed from
  // `#collection_index * 30`. Written via a `view` binding into a local
  // property that `offset` reads. If Bedrock resolves the arithmetic
  // and applies it, the slots land at x = 0, 30, 60, 90, 120. If it
  // doesn't, they all sit at x = 0.

  "proof_u1_canvas": {
    "type": "panel",
    "size": [ 200, 100 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "slot@server_form.proof_u1_slot": {}
      }
    ],
    "collection_name": "form_buttons"
  },

  "proof_u1_slot": {
    "type": "image",
    "size": [ 20, 20 ],
    "texture": "textures/ui/electrical_map/wall",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ "#slot_x", 40 ],
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#collection_index * 30)",
        "target_property_name": "#slot_x"
      }
    ]
  },

  // -- U4 · textures/ui/White availability ----------------------------
  // Zero magic — just references the stock path directly and centres
  // it. If the client resolves the path we see a solid white 32×32.

  "proof_u4_canvas": {
    "type": "panel",
    "size": [ 100, 100 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "swatch": {
          "type": "image",
          "size": [ 32, 32 ],
          "texture": "textures/ui/White",
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },

  // -- U8 · image visibility independent of button visibility ---------
  // For each collection item the slot renders BOTH an always-visible
  // white bar AND a hitbox button whose visibility is gated on the
  // button text being non-empty (`#form_button_text != ''`). Five
  // items are sent (three with text "on", two with text "" — see
  // uiProofs.js). Expected pass: five bars visible, three of them
  // capture clicks.

  "proof_u8_canvas": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 200, "100%" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 20 ],
    "controls": [
      {
        "slot@server_form.proof_u8_slot": {}
      }
    ],
    "collection_name": "form_buttons"
  },

  "proof_u8_slot": {
    "type": "panel",
    "size": [ "100%", 16 ],
    "controls": [
      {
        "always_bar": {
          "type": "image",
          "size": [ "100%", 4 ],
          "layer": 1,
          "anchor_from": "center",
          "anchor_to": "center",
          "texture": "textures/ui/electrical_map/wall",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "conditional_hitbox": {
          "type": "button",
          "size": [ "100%", "100%" ],
          "layer": 2,
          "$pressed_button_name": "button.form_button_click",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_name_override": "#label",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#label = ''))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
