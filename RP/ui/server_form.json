{
  "namespace": "server_form",

  //
  // Grid override for the electrical breaker box. Only applies when the
  // ActionForm's title starts with "ELECTRICAL_MAP|". Every other form
  // (blueprint editor etc.) falls through to a manually replicated
  // vanilla button stack — the collection_details binding on the
  // individual buttons is what lets a plain stack_panel iterate a form
  // button collection without going through common_dialogs.
  //

  // -- 10x10 grid cell: tile image + invisible click hitbox ------------

  "electrical_cell": {
    "type": "panel",
    "size": [ 10, 10 ],
    "controls": [
      {
        "cell_image": {
          "type": "image",
          "size": [ "100%", "100%" ],
          "texture": "#form_button_texture",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_texture"
            }
          ]
        }
      },
      {
        "cell_hitbox": {
          "type": "button",
          "size": [ "100%", "100%" ],
          "layer": 2,
          "$pressed_button_name": "button.form_button_click",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // -- The 32x24 grid itself. Fills 320x240 UI pixels ------------------

  "electrical_grid_wrapper": {
    "type": "grid",
    "size": [ 320, 240 ],
    "grid_dimensions": [ 32, 24 ],
    "grid_item_template": "server_form.electrical_cell",
    "collection_name": "form_buttons"
  },

  // -- Vanilla replica: one button, uses light_content_button base
  //    which is the exact style vanilla server_form uses ---------------

  "vanilla_form_button@common_buttons.light_content_button": {
    "size": [ "100%", 20 ],
    "$pressed_button_name": "button.form_button_click",
    "$button_content": "server_form.vanilla_form_button_content",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ]
  },

  "vanilla_form_button_content": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "button_label": {
          "type": "label",
          "text": "#form_button_text",
          "color": [ 1, 1, 1 ],
          "size": [ "100% - 6px", "default" ],
          "layer": 3,
          "offset": [ 0, 0 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_text"
            }
          ]
        }
      }
    ]
  },

  // Stack of vanilla buttons. The collection is iterated by the child
  // template's collection_details binding — plain stack_panel handles
  // this correctly for form button collections.
  "vanilla_button_stack": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "collection_name": "form_buttons",
    "controls": [
      { "b@server_form.vanilla_form_button": {} }
    ]
  },

  // -- The one override. Two children, exactly one visible per form ---

  "long_form_dynamic_buttons_panel": {
    "type": "panel",
    "size": [ "100%", "100%c" ],
    "controls": [
      {
        "electrical@server_form.electrical_grid_wrapper": {
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'ELECTRICAL_MAP|') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "vanilla@server_form.vanilla_button_stack": {
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - 'ELECTRICAL_MAP|') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
