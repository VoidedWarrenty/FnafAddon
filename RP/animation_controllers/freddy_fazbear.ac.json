{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.fnaf.freddy_fazbear": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            { "perform": "q.property('fnaf:anim') == 'perform'" },
            { "statue":  "q.property('fnaf:anim') == 'statue'"  },
            { "walk":    "q.property('fnaf:anim') == 'walk'"    },
            { "chase":   "q.property('fnaf:anim') == 'chase'"   },
            { "attack":  "q.property('fnaf:anim') == 'attack'"  },
            { "sit":     "q.property('fnaf:anim') == 'sit'"     }
          ]
        },
        "perform": {
          "animations": ["perform"],
          "transitions": [{ "idle": "q.property('fnaf:anim') != 'perform'" }]
        },
        "statue": {
          "animations": ["statue"],
          "transitions": [{ "idle": "q.property('fnaf:anim') != 'statue'" }]
        },
        "walk": {
          "animations": ["walk"],
          "transitions": [{ "idle": "q.property('fnaf:anim') != 'walk'" }]
        },
        "chase": {
          "animations": ["chase"],
          "transitions": [{ "idle": "q.property('fnaf:anim') != 'chase'" }]
        },
        "attack": {
          "animations": ["attack"],
          "transitions": [{ "idle": "q.property('fnaf:anim') != 'attack'" }]
        },
        "sit": {
          "animations": ["sit"],
          "transitions": [{ "idle": "q.property('fnaf:anim') != 'sit'" }]
        }
      }
    }
  }
}
